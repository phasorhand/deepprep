  "target_schema": {
    "description": "I need a table containing ratings by genre for each director in 2019 and 2020. One row per (director, genre) pair.",
    "columns": [
      {
        "name": "director_name",
        "dtype": "object",
        "description": "The name of the director."
      },
      {
        "name": "genre",
        "dtype": "object",
        "description": "A single movie genre category (never multi-valued)."
      },
      {
        "name": "2019",
        "dtype": "float64",
        "description": "Average rating for the director's movies in 2019."
      },
      {
        "name": "2020",
        "dtype": "float64",
        "description": "Average rating for the director's movies in 2020."
      }
    ]
